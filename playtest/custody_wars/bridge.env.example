# Copy to playtest/custody_wars/bridge.env and export before `python -m spiral_ln.custody_wars bridge`.
# Modes: policy (scripted), codex (local `codex exec --output-schema`), openai (OpenAI-compatible upstream).
CSA_BRIDGE_MODE=codex
CSA_BRIDGE_HOST=127.0.0.1
CSA_BRIDGE_PORT=8789
# Must match the "secret" in the session config's webhook agents; unsigned or stale requests get 401.
CSA_BRIDGE_SECRET=change-me
CSA_BRIDGE_TIMEOUT_MS=600000
# 1 = answer with the scripted policy when the upstream fails (They Sing behaviour);
# 0 = return 502 so the harness logs and counts the fallback itself (recommended for evals).
CSA_BRIDGE_LOCAL_FALLBACK=0
# codex mode
CSA_BRIDGE_CODEX_MODEL=
# openai mode: point at your local authenticated Codex/OpenAI-compatible bridge, rooted at /v1.
CSA_BRIDGE_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
CSA_BRIDGE_OPENAI_MODEL=gpt-5.2-codex
CSA_BRIDGE_OPENAI_API_KEY=
